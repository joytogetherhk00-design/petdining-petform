{
  "name": "\u5831\u540d\u78ba\u8a8d\u81ea\u52d5\u901a\u77e5",
  "description": "\u7576\u5831\u540d\u72c0\u614b\u8b8a\u66f4\u70ba\u5df2\u78ba\u8a8d\u6642\uff0c\u81ea\u52d5\u767c\u9001\u78ba\u8a8d\u90f5\u4ef6\uff08Quota \u652f\u4ed8\uff09",
  "trigger": {
    "condition": "${ ((.trigger.changed_fields | index(\"status\") != null) and (.trigger.data.status == \"confirmed\")) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "Enrollments"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "migrated_workflow",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "notifyEnrollmentAuto",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "notifyEnrollmentAuto"
  }
}